# Server Configuration
PORT=5000
NODE_ENV=production

# Database & Authentication (REQUIRED)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resumeiq?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here

# AI Service (REQUIRED)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Client CORS & Password Reset URL (Comma-separated allowed for multiple origins)
CLIENT_URL=https://your-frontend.vercel.app,http://localhost:5173

# Production SMTP Settings (SendGrid, Brevo, Mailgun, Amazon SES, etc.)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password_or_api_key
SMTP_SECURE=false

# Development / Testing Mailtrap Alternative (Optional if SMTP_* is set)
# MAILTRAP_HOST=sandbox.smtp.mailtrap.io
# MAILTRAP_PORT=2525
# MAILTRAP_USER=your_mailtrap_user
# MAILTRAP_PASS=your_mailtrap_pass

# Email Sender Profile
FROM_NAME=ResumeIQ
FROM_EMAIL=noreply@yourdomain.com

